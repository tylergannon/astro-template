{
  "name": "astro-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:astro": "astro check",
    "format:rsvelte": "rsvelte-fmt --no-native-js --no-native-css .",
    "format:rsvelte:check": "rsvelte-fmt --no-native-js --no-native-css --check .",
    "lint:rsvelte": "rsvelte-lint --max-warnings 0 src/",
    "check:rsvelte": "rsvelte-check --tsgo --tsconfig tsconfig.json --fail-on-warnings",
    "verify": "vp check && rsvelte-fmt --no-native-js --no-native-css --check . && rsvelte-lint --max-warnings 0 src/ && rsvelte-check --tsgo --tsconfig tsconfig.json --fail-on-warnings && astro check"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.123",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.31.0",
    "astro": "^7.2.2",
    "astro-icon": "^1.1.5",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.0.1",
    "layerchart": "^2.2.0",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "svelte": "^5.56.9",
    "svelte-sonner": "^1.2.1",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul-svelte": "1.0.0-next.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@rsvelte/fmt": "^0.7.11",
    "@rsvelte/lint": "^0.10.16",
    "@rsvelte/svelte-check": "^0.5.19",
    "@rsvelte/vite-plugin-svelte": "^0.5.2",
    "@sveltejs/vite-plugin-svelte": "npm:@rsvelte/vite-plugin-svelte@0.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "shadcn-svelte": "^1.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
